{
	"configurations": [
		{
			"name": "Debug",
			"type": "cppdbg",
			"request": "launch",
			
			"program": "${input:target}",
			"args": [
				"${input:instance}"
			],

			"cwd": "${workspaceFolder}",
			"stopAtEntry": false,
			"launchCompleteCommand": "exec-run",
			
			"MIMode": "gdb",
			"miDebuggerPath": "/usr/bin/gdb",

			"environment": []
		}
	],
	"inputs": [
		{
			"id": "target",
			"type": "command",
			"command": "extension.commandvariable.file.pickFile",
			"args" : {
				"description" : "Select target",
				"include" : "build/exe/*",
				"display" : "fileName"
			}
		},
		{
			"id": "instance",
			"type": "command",
			"command": "extension.commandvariable.file.pickFile",
			"args" : {
				"description" : "Select instance",
				"include" : "data/*.json",
				"display" : "fileName",
				"addEmpty" : true
			}
		}
	],
	
	"version": "0.2.0",
}