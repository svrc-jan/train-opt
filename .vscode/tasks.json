{
	"tasks": [
		{
			"label": "CMake: current Release",
			"type": "shell",
			"command": "echo 'Builing ${fileBasenameNoExtension} Release'",
			"dependsOn": [
				"CMake: Configure Release",
				"CMake: Build current"
			],
			"group": {
				"kind": "build",
				"isDefault": true
			}
		},
		{
			"label": "CMake: current Debug",
			"type": "shell",
			"command": "echo 'Builing ${fileBasenameNoExtension} Debug'",
			"dependsOn": [
				"CMake: Configure Debug",
				"CMake: Build current"
			],
			"group": "build"
		},
		{
			"label": "CMake: current Profiling",
			"type": "shell",
			"command": "echo 'Builing ${fileBasenameNoExtension} Profiling'",
			"dependsOn": [
				"CMake: Configure Profiling",
				"CMake: Build current"
			],
			"group": "build"
		},
		{
			"label": "CMake: Build current",
			"type": "shell",
			"command": "cmake --build . --target ${fileBasenameNoExtension} -j 8",
			"group": {
				"kind": "build",
			}
		},
		{
			"label": "CMake: Build clean",
			"type": "shell",
			"command": "cmake --build . --target clean",
			"group": "build"
		},
		{
			"label": "CMake: Configure Debug",
			"type": "shell",
			"command": "cmake . -DCMAKE_BUILD_TYPE=Debug",
			"group": "build"
		},
		{
			"label": "CMake: Configure Release",
			"type": "shell",
			"command": "cmake . -DCMAKE_BUILD_TYPE=Release",
			"group": "build"
		},
		{
			"label": "CMake: Configure Profiling",
			"type": "shell",
			"command": "cmake . -DCMAKE_BUILD_TYPE=Profiling",
			"group": "build"
		}
	],
	"version": "2.0.0"
}
