{
	"tasks": [
		{
			"label": "CMake: Build current Release",
			"type": "shell",
			"command": "cmake --build . --target ${fileBasenameNoExtension} --config Release -j 8",
			"dependsOn": [
				"CMake: Configure"
			],
			"group": {
				"kind": "build",
				"isDefault": "${workspaceFolder}/apps/*.cpp"
			}
		},
		{
			"label": "CMake: Build current Debug",
			"type": "shell",
			"command": "cmake --build . --target ${fileBasenameNoExtension} --config Debug -j 8",
			"dependsOn": [
				"CMake: Configure"
			],
			"group": "build"
		},
		{
			"label": "CMake: Build clean",
			"type": "shell",
			"command": "cmake --build . --target clean",
			"group": "build"
		},
		{
			"label": "CMake: Configure",
			"type": "shell",
			"command": "cmake .",
			"group": "build"
		}
	],
	"version": "2.0.0"
}
